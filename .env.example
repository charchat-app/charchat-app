# 복사: .env.local 로 저장 후 값 변경 (.env*.local 은 git에 올라가지 않는다)
# 클라이언트에 노출되는 값만 EXPO_PUBLIC_ 접두사를 쓴다. 비밀번호·API 키는 넣지 않는다.

# charchat-server 주소. 실기기에서는 localhost 대신 PC의 LAN IP를 쓴다.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# 계정 설계 전 임시 인증용 개발 사용자 번호(양의 정수). 서버의 X-User-Id 헤더로 보낸다.
EXPO_PUBLIC_DEV_USER_ID=1
