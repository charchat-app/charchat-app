# 복사: .env.local 로 저장 후 값 변경 (.env*.local 은 git에 올라가지 않는다)
# 클라이언트에 노출되는 값만 EXPO_PUBLIC_ 접두사를 쓴다. 비밀번호·API 키는 넣지 않는다.

# charchat-server 주소. 실기기에서는 localhost 대신 PC의 LAN IP를 쓴다.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# 개발용 사용자 번호(양의 정수). 개발용 헤더 모드에서 서버의 X-User-Id 헤더로 보낸다.
# 서버도 AUTH_DEV_HEADER_ENABLED=true여야 받는다.
EXPO_PUBLIC_DEV_USER_ID=1

# BASE-03 인증 방식. header: 로그인 없이 X-User-Id로 이용(기존 방식), token: 로그인 화면을 거쳐 Bearer 토큰 사용.
# 비워 두면 EXPO_PUBLIC_DEV_USER_ID가 있을 때 header로 본다(기존 개발 설정 호환).
# EXPO_PUBLIC_DEV_AUTH=token

# BASE-03 로그인 화면에 개발용 로그인 키 입력란을 보인다(1일 때만). 서버 AUTH_DEV_LOGIN_ENABLED=true가 필요하다.
# EXPO_PUBLIC_DEV_LOGIN=1
